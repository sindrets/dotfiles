[user]
	email = sindrets@gmail.com
	name = Sindre T. Strøm

[core]
	pager = delta

[init]
	defaultBranch = main

[submodule]
	recurse = false

[push]
	autoSetupRemote = true

[pull]
	rebase = true

[branch]
	sort = authordate

[interactive]
	diffFilter = delta --color-only

[diff]
	tool = nvimdiff

[difftool "nvimdiff"]
	cmd = nvim -d $LOCAL $REMOTE

[rebase]
	autoStash = true

[merge]
	tool = nvimmerge
	conflictstyle = zdiff3

[mergetool]
	hideResolved = true

[mergetool "nvimmerge"]
	cmd = nvim -d "$MERGED" "$BASE" "$LOCAL" "$REMOTE"

[delta]
	features = line-numbers decorations
	whitespace-error-style = 22 reverse
	syntax-theme = Catppuccin Mocha
	plus-style = syntax "#273528"
	plus-non-emph-style = syntax "#273528"
	plus-empty-line-marker-style = syntax "#273528"
	plus-emph-style = "#98d3a4" "#38513f"
	line-numbers-plus-style = "#98d3a4"
	minus-style = syntax "#3c2530"
	minus-empty-line-marker-style = syntax "#3c2530"
	minus-non-emph-style = syntax "#3c2530"
	minus-emph-style = "#ff92c8" "#5f374a"
	line-numbers-minus-style = "#ff92c8"
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[alias]
	lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %C(bold blue)<%an> %Cgreen(%cr)%Creset' --abbrev-commit
	wt = "!f() { source $HOME/.config/git/lib.sh && git_wt $@; }; f"
	pr-checkout = "!f() { source $HOME/.config/git/lib.sh && git_pr_checkout $@; }; f"
	pr-wt = "!f() { source $HOME/.config/git/lib.sh && git_pr_wt $@; }; f"
	init-bare = "!f() { source $HOME/.config/git/lib.sh && git_init_bare $@; }; f"
	ib = "!f() { source $HOME/.config/git/lib.sh && git_init_bare $@; }; f"
	clone-bare = "!f() { source $HOME/.config/git/lib.sh && git_clone_bare $@; }; f"
	cb = "!f() { source $HOME/.config/git/lib.sh && git_clone_bare $@; }; f"
	stash-keep = !git stash store $(git stash create)
	changed-files = "!f() { source $HOME/.config/git/lib.sh && git_changed_files $@; }; f"
	default-branch = "!f() { source $HOME/.config/git/lib.sh && git_default_branch $@; }; f"
	ls-worktree-usage = "!f() { source $HOME/.config/git/lib.sh && git_ls_worktree_usage $@; }; f"
[credential "https://github.com"]
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = !/usr/bin/gh auth git-credential

[include]
	path = ./config_overrides
