#!/bin/bash
#
# Display terminal color codes.
#
# No options : 8x2 background-color grid.
# -a         : full table for the 8 main colors only (40m–47m / m/30m–37m).
# -aa        : full output including bright colors.
#

test_text='TiP'

bg_main=("40m" "41m" "42m" "43m" "44m" "45m" "46m" "47m")
fg_main=("m" "30m" "31m" "32m" "33m" "34m" "35m" "36m" "37m")

bg_bright=("100m" "101m" "102m" "103m" "104m" "105m" "106m" "107m")
fg_bright=("1m" "90m" "91m" "92m" "93m" "94m" "95m" "96m" "97m")

# ---------- default: dense 8x2 background-color grid, no text ----------
show_grid() {
    for i in $(seq 0 7); do
        printf '\e[%s    \e[0m' "${bg_main[$i]}"
    done
    echo

    for i in $(seq 0 7); do
        printf '\e[%s    \e[0m' "${bg_bright[$i]}"
    done
    echo
}

# ---------- full table (optionally subset) ----------
show_table() {
    local -a bg_list=() fg_list=()
    local mode="$1"
    shift

    if [[ "$mode" == "-a" ]]; then
        fg_list=("${fg_main[@]}")
    else
        local -a fl=()
        for i in $(seq 0 8); do
            fl+=("${fg_main[$i]}" "${fg_bright[$i]}")
        done
        fg_list=("${fl[@]}")
    fi

    if [[ "$mode" == "-aa" ]]; then
        local -a bl=()
        for i in $(seq 0 7); do
            bl+=("${bg_main[$i]}" "${bg_bright[$i]}")
        done
        bg_list=("${bl[@]}")
    else
        bg_list=("$@")
    fi

    echo -en "          "
    for bg in "${bg_list[@]}"; do printf '% 7s' "$bg"; done
    echo

    for fg in "${fg_list[@]}"; do
        printf " % 3s \e[$fg  $test_text  " "$fg"

        for bg in "${bg_list[@]}"; do
            printf "\e[%s\e[%s  $test_text  \e[0m" "$fg" "$bg"
        done
        echo
    done
    echo
}

case "${1:-}" in
-a) show_table "-a" "${bg_main[@]}" ;;
-aa) show_table "-aa" ;;
*) show_grid ;;
esac
